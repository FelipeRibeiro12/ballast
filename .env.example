# Copie para .env e preencha. O .env real nunca entra no repositório.
# Formato: jdbc:postgresql://localhost:5432/<POSTGRES_DB>
DATABASE_URL=
DB_USER=
DB_PASSWORD=
# Dono do schema, usado só pelo Flyway. No dev, os mesmos de POSTGRES_USER/POSTGRES_PASSWORD.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Cadastro pela API: fechado por padrão. Aberto, vale o limite por IP da F20.5 (ADR-049).
REGISTRO_ABERTO=false
# Teto de usuários cadastrados, para caber no tier gratuito. Vazio vale 20.
CADASTRO_MAX_USUARIOS=
# Tetos por usuário (ADR-055), de 1 a 1.000.000. Estourado, a criação responde 409 "limite de X
# atingido". Vazio vale o padrão: contas 100, recorrências ativas 200, compras parceladas 1000,
# títulos de renda fixa 500, movimentos de cripto 20000, ativos de cripto 200, cotações 100000.
LIMITE_CONTAS=
LIMITE_RECORRENCIAS_ATIVAS=
LIMITE_COMPRAS_PARCELADAS=
LIMITE_TITULOS_RENDA_FIXA=
LIMITE_MOVIMENTOS_CRIPTO=
LIMITE_ATIVOS_CRIPTO=
LIMITE_COTACOES=
LIMITE_CATEGORIAS=
LIMITE_TERCEIROS=
LIMITE_VISOES_SALDO=
# Prazo por instrução do DELETE /contas/{id}, como 15s. Vazio vale 15s. Estourado, responde 503.
TIMEOUT_APAGAR_CONTA=
# Chave AES-256 do segredo do MFA, em base64: openssl rand -base64 32 (ADR-050). Vazia, o MFA
# não liga. Perder a chave obriga quem tem MFA a entrar com código de recuperação.
MFA_CHAVE=
# Mostra a tela de cadastro no web (ADR-022). Só funciona junto com REGISTRO_ABERTO=true.
VITE_REGISTRO_ABERTO=
# Vazio vale true. false só é aceito com APP_ENV=development (Safari recusa cookie Secure sobre
# HTTP); com outro APP_ENV a API não sobe.
COOKIE_SECURE=
APP_ENV=
# Origens do navegador aceitas em POST, PUT, PATCH e DELETE, separadas por vírgula (ADR-051). Vazio
# aceita só a origem do próprio Host, que cobre o Vite em dev. Em produção, o domínio do app no
# Vercel, por exemplo https://ballast.vercel.app.
ORIGENS_PERMITIDAS=
# Usuário inicial, lido por `make seed`. Senha de 12 a 128 caracteres; nome é opcional.
SEED_EMAIL=
SEED_SENHA=
SEED_NOME=
# Serve /v3/api-docs. Só true em desenvolvimento; qualquer outro valor (ou ausente) mantém desligado.
API_DOCS_ENABLED=false
# Job diário que estende as recorrências 12 meses à frente (ADR-026). Vazio vale true; false desliga,
# por exemplo apontando para um banco que outra instância já atende.
BALLAST_RECURRENCE_JOB_ENABLED=
HOST=127.0.0.1
PORT=8080
# Cotação automática de cripto pela CoinGecko, plano Demo (ADR-040). Crie a chave em
# coingecko.com/en/developers/dashboard. Vazia, o job não roda e a cotação fica só a digitada.
# A URL vazia vale https://api.coingecko.com/api/v3.
COINGECKO_API_KEY=
COINGECKO_API_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
