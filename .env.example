# Copie para .env e preencha. O .env real nunca entra no repositório.
# Formato: jdbc:postgresql://localhost:5432/<POSTGRES_DB>
DATABASE_URL=
DB_USER=
DB_PASSWORD=
# Dono do schema, usado só pelo Flyway. No dev, os mesmos de POSTGRES_USER/POSTGRES_PASSWORD.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Cadastro pela API: fechado por padrão. Só abra depois de haver limite por IP na borda.
REGISTRO_ABERTO=false
# Mostra a tela de cadastro no web (ADR-022). Só funciona junto com REGISTRO_ABERTO=true.
VITE_REGISTRO_ABERTO=
# Vazio vale true. false só é aceito com APP_ENV=development (Safari recusa cookie Secure sobre
# HTTP); com outro APP_ENV a API não sobe.
COOKIE_SECURE=
APP_ENV=
# Usuário inicial, lido por `make seed`. Senha de 12 a 128 caracteres; nome é opcional.
SEED_EMAIL=
SEED_SENHA=
SEED_NOME=
# Serve /v3/api-docs. Só true em desenvolvimento; qualquer outro valor (ou ausente) mantém desligado.
API_DOCS_ENABLED=false
# Job diário que estende as recorrências 12 meses à frente (ADR-026). Vazio vale true; false desliga,
# por exemplo apontando para um banco que outra instância já atende.
BALLAST_RECURRENCE_JOB_ENABLED=
HOST=127.0.0.1
PORT=8080
# Cotação automática de cripto pela CoinGecko, plano Demo (ADR-040). Crie a chave em
# coingecko.com/en/developers/dashboard. Vazia, o job não roda e a cotação fica só a digitada.
# A URL vazia vale https://api.coingecko.com/api/v3.
COINGECKO_API_KEY=
COINGECKO_API_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
