# Copie para /opt/ballast/api.env na VM, chmod 600. Nunca entra no repositório.
# Endpoint direto do Neon (sem -pooler), São Paulo, com TLS verificado pela cadeia da JVM:
# jdbc:postgresql://<endpoint>.sa-east-1.aws.neon.tech/<banco>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DATABASE_URL=
# Papel só com DML (ADR-021). O dono do schema não vem para a VM: só o passo de migração usa.
DB_USER=
DB_PASSWORD=
# Cadastro fechado: o primeiro usuário entra pelo seed do runbook.
REGISTRO_ABERTO=false
# Teto de usuários para caber no tier gratuito (ADR-049). Vazio vale 20.
CADASTRO_MAX_USUARIOS=
# Origem do PWA (ADR-051). Sem ela toda escrita dá 403, porque o Vercel repassa com o Host da VM.
ORIGENS_PERMITIDAS=
# Chave do segredo do MFA (ADR-050): openssl rand -base64 32. Guarde uma cópia fora da VM, num
# gerenciador de senhas. Sem ela, só o código de recuperação entra.
MFA_CHAVE=
# Chave do plano Demo da CoinGecko (ADR-040). Vazia, a cotação fica só a digitada.
COINGECKO_API_KEY=
# Rendimento diário do cofrinho (ADR-074): lança o rendimento estimado às 03:30, hora de São Paulo.
# Ligado por padrão, como os outros jobs; só descomente para desligar. O cron fica em
# BALLAST_COFRINHO_CRON (Spring cron, segundos primeiro).
# BALLAST_COFRINHO_JOB_ENABLED=false
